# OpenXX Configuration

# WhatsApp admin phone number (no + sign)
OPENX_DEV_PHONE_NUMBER=

# ── AI Provider ──────────────────────────────────────────────────────
# Options: openrouter, openai, claude, chatgpt, gemini, rest
OPENX_AI_PROVIDER=openai

# OpenAI-compatible (SumoPod, Together, Groq, etc.)
OPENX_OPENAI_BASE_URL=https://ai.sumopod.com
OPENX_OPENAI_API_KEY=
OPENX_OPENAI_MODEL=gpt-4o-mini

# OpenRouter
# OPENX_OPENROUTER_API_KEYS=

