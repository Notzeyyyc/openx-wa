# OpenXX Configuration

# WhatsApp admin phone number
OPENX_DEV_PHONE_NUMBER=

# AI Provider (openai, claude, chatgpt, gemini, openrouter)
OPENX_AI_PROVIDER=openai

# OpenAI-compatible
OPENX_OPENAI_BASE_URL=https://ai.sumopod.com
OPENX_OPENAI_API_KEY=
OPENX_OPENAI_MODEL=gpt-4o-mini

# Voice/TTS (default: Furina)
OPENX_TTS_VOICE=voice_furina_

# Covenant API (optional)
OPENX_COVENANT_API_KEY=
OPENX_COVENANT_MODEL=google/gemini-2.5-flash
