# OpenXX Configuration

# WhatsApp admin phone number
OPENX_DEV_PHONE_NUMBER=

# AI API (OpenAI-compatible /v1/chat/completions — SumoPod, OpenRouter, etc.)
OPENX_OPENAI_BASE_URL=https://ai.sumopod.com
OPENX_OPENAI_API_KEY=
OPENX_OPENAI_MODEL=gpt-4o-mini

# FGSi API (used by .search and .img)
OPENX_FGSI_BASE_URL=https://fgsi.dpdns.org/api/ai/claude
OPENX_FGSI_API_KEY=

# Voice/TTS (default: Furina; key falls back to OPENX_FGSI_API_KEY)
OPENX_TTS_API_KEY=
OPENX_TTS_VOICE=voice_furina_

# Spotify (via Covenant API)
OPENX_SPOTIFY_API_KEY=
