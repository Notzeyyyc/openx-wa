# Copy to .env and fill values. Never commit .env.

# WhatsApp admin phone number (no + sign). Example: 628123456789
OPENX_DEV_PHONE_NUMBER=

# ── AI Provider ──────────────────────────────────────────────────────
# Provider: "openrouter", "rest", or "openai"
OPENX_AI_PROVIDER=rest

# OpenRouter settings (used when OPENX_AI_PROVIDER=openrouter)
OPENX_OPENROUTER_API_KEYS=

# REST API settings (used when OPENX_AI_PROVIDER=rest)
OPENX_REST_BASE_URL=https://zelapioffciall.dpdns.org/ai/sdk
OPENX_REST_API_KEY=your-api-key-here
OPENX_REST_MODEL=deepseek/deepseek-v4-pro
OPENX_REST_METHOD=GET
OPENX_REST_PARAM_NAME=text
OPENX_REST_APIKEY_PARAM=apikey
OPENX_REST_ANSWER_FIELD=response
OPENX_REST_HEADERS={}

# OpenAI-compatible settings (used when OPENX_AI_PROVIDER=openai)
# Works with any OpenAI-compatible API (SumoPod, Together, Groq, etc.)
OPENX_OPENAI_BASE_URL=https://ai.sumopod.com
OPENX_OPENAI_API_KEY=
OPENX_OPENAI_MODEL=gpt-4o-mini

# Claude API settings (used when OPENX_AI_PROVIDER=claude)
OPENX_CLAUDE_BASE_URL=https://fgsi.dpdns.org/api/ai/claude
OPENX_CLAUDE_API_KEY=
OPENX_CLAUDE_MODEL=anthropic/claude-opus-4.8
OPENX_CLAUDE_WEB_SEARCH=false
OPENX_CLAUDE_DEEP_RESEARCH=false

# ChatGPT API settings (used when OPENX_AI_PROVIDER=chatgpt)
OPENX_CHATGPT_BASE_URL=https://fgsi.dpdns.org/api/ai/chatgpt
OPENX_CHATGPT_API_KEY=
OPENX_CHATGPT_MODEL=openai/gpt-4o
OPENX_CHATGPT_WEB_SEARCH=false
OPENX_CHATGPT_DEEP_RESEARCH=false

# Gemini API settings (used when OPENX_AI_PROVIDER=gemini)
OPENX_GEMINI_BASE_URL=https://fgsi.dpdns.org/api/ai/gemini
OPENX_GEMINI_API_KEY=
OPENX_GEMINI_MODEL=google/gemini-2.5-flash
OPENX_GEMINI_WEB_SEARCH=false
OPENX_GEMINI_DEEP_RESEARCH=false

# ── MCP Server ───────────────────────────────────────────────────────
# URL of the MCP HTTP API server (local or Railway)
# Local Termux: http://localhost:8765
# Railway: https://openx-mcp.up.railway.app
OPENX_MCP_URL=http://localhost:8765

# API key for MCP auth (must match OPENX_HTTP_API_KEY on Railway)
OPENX_MCP_API_KEY=

# ── ADB ──────────────────────────────────────────────────────────────
# ADB mode: "auto" (TCP detect), "usb" (USB cable), or explicit port (e.g. 5555)
OPENX_ADB_PORT=usb

# ── Plugins ──────────────────────────────────────────────────────────
OPENX_PLUGINS_NPM=
OPENX_ALLOW_UNPINNED_PLUGINS=false

# Music Player API
OPENX_MUSIC_API_KEY=
