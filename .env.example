# OpenXX Configuration

# AI API (OpenAI-compatible /v1/chat/completions — Zen, OpenRouter, SumoPod, etc.)
# Base URL should NOT include /v1 (appended automatically)
OPENX_OPENAI_BASE_URL=https://ai.sumopod.com
# AgentRouter direct: bot spoofs an approved client identity (see src/provider.js)
# OPENX_OPENAI_BASE_URL=https://agentrouter.org
# OpenCode inference: chat mount at /inference/openai, models at /inference (bot handles offset automatically)
# OPENX_OPENAI_BASE_URL=https://opencode.ai/inference/openai
OPENX_OPENAI_API_KEY=
OPENX_OPENAI_MODEL=gpt-4o-mini

# FGSi API (used by .search and .img)
OPENX_FGSI_BASE_URL=https://fgsi.dpdns.org/api/ai/claude
OPENX_FGSI_API_KEY=

# yt-dlp (.dl / [DOWNLOAD_MEDIA]). Standalone binary, no Python needed.
# Auto-downloads to ./bin on boot if missing; run `pnpm ytdlp:install` to force.
# OPENX_YTDLP_PATH=
# OPENX_YTDLP_CHANNEL=nightly
# OPENX_YTDLP_JS_RUNTIME=node
# OPENX_YTDLP_MAX_MB=64
