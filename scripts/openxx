#!/data/data/com.termux/files/usr/bin/sh
# OpenXX CLI — Start Menu + Commands
# Usage: openxx [command]

GREEN='\033[0;32m'
RED='\033[0;31m'
CYAN='\033[0;36m'
YELLOW='\033[1;33m'
NC='\033[0m'

INSTALL_DIR="$HOME/openxx"

show_status() {
    echo ""
    echo -e "${CYAN}╔══════════════════════════════════════╗${NC}"
    echo -e "${CYAN}║           OpenXX Status              ║${NC}"
    echo -e "${CYAN}╚══════════════════════════════════════╝${NC}"
    echo ""
    pm2 status
    echo ""
}

show_menu() {
    clear
    echo -e "${CYAN}╔══════════════════════════════════════╗${NC}"
    echo -e "${CYAN}║           OpenXX Manager             ║${NC}"
    echo -e "${CYAN}╚══════════════════════════════════════╝${NC}"
    echo ""
    echo -e "  ${GREEN}1${NC}) Start all services"
    echo -e "  ${RED}2${NC}) Stop all services"
    echo -e "  ${YELLOW}3${NC}) Restart all services"
    echo -e "  ${CYAN}4${NC}) Check status"
    echo -e "  ${CYAN}5${NC}) View bot logs"
    echo -e "  ${CYAN}6${NC}) View MCP logs"
    echo -e "  ${YELLOW}7${NC}) Edit config (.env)"
    echo -e "  ${YELLOW}8${NC}) Update project (git pull)"
    echo -e "  ${GREEN}9${NC}) Setup keep-alive (anti-kill)"
    echo -e "  ${RED}0${NC}) Exit"
    echo ""
    echo -n "  Select: "
    read choice

    case $choice in
        1) start_all ;;
        2) stop_all ;;
        3) restart_all ;;
        4) show_status; press_enter ;;
        5) pm2 logs openxx-bot --lines 50 ;;
        6) pm2 logs openxx-mcp --lines 50 ;;
        7) nano "$INSTALL_DIR/.env" ;;
        8) update_project; press_enter ;;
        9) bash "$INSTALL_DIR/scripts/termux-keepalive.sh"; press_enter ;;
        0) exit 0 ;;
        *) echo -e "${RED}Invalid option${NC}"; press_enter ;;
    esac
}

press_enter() {
    echo ""
    echo -e "${CYAN}Press Enter to continue...${NC}"
    read
}

start_all() {
    echo -e "${GREEN}Starting services...${NC}"
    cd "$INSTALL_DIR"
    pm2 start index.js --name openxx-bot --node-args="--max-old-space-size=128 --gc-interval=100 --expose-gc" 2>/dev/null || pm2 restart openxx-bot
    if [ -f "$INSTALL_DIR/openx-mcp/openx-mcp" ]; then
        pm2 start "$INSTALL_DIR/openx-mcp/openx-mcp" --name openxx-mcp --cwd "$INSTALL_DIR/openx-mcp" 2>/dev/null || pm2 restart openxx-mcp
    fi
    pm2 save
    echo -e "${GREEN}✓ All services started${NC}"
    press_enter
}

stop_all() {
    echo -e "${RED}Stopping services...${NC}"
    pm2 stop all
    pm2 save
    echo -e "${GREEN}✓ All services stopped${NC}"
    press_enter
}

restart_all() {
    echo -e "${YELLOW}Restarting services...${NC}"
    pm2 restart all
    echo -e "${GREEN}✓ All services restarted${NC}"
    press_enter
}

update_project() {
    echo -e "${YELLOW}Updating project...${NC}"
    cd "$INSTALL_DIR"
    git pull
    pnpm install
    if [ -d "$INSTALL_DIR/openx-mcp" ]; then
        cd "$INSTALL_DIR/openx-mcp"
        go build -o openx-mcp . 2>/dev/null && echo -e "${GREEN}✓ MCP rebuilt${NC}"
    fi
    echo -e "${GREEN}✓ Update complete${NC}"
}

uninstall() {
    echo -e "${RED}This will stop and remove OpenXX services.${NC}"
    echo -n "Continue? (y/N): "
    read confirm
    if [ "$confirm" = "y" ] || [ "$confirm" = "Y" ]; then
        pm2 delete all 2>/dev/null
        pm2 save
        rm -f "$PREFIX/bin/openxx"
        echo -e "${GREEN}✓ Uninstalled. Project files kept at ~/openxx${NC}"
    else
        echo "Cancelled."
    fi
    press_enter
}

# ── Handle subcommands ──
case "$1" in
    start)
        start_all
        ;;
    stop)
        stop_all
        ;;
    restart)
        restart_all
        ;;
    status)
        show_status
        ;;
    logs)
        pm2 logs openxx-bot --lines 50
        ;;
    logs-mcp)
        pm2 logs openxx-mcp --lines 50
        ;;
    update)
        update_project
        ;;
    keepalive|ka)
        echo -e "${CYAN}Setting up keep-alive...${NC}"
        pkg install -y termux-api 2>/dev/null
        pkill -f keepalive-daemon 2>/dev/null
        nohup bash -c 'while true; do termux-notification -i openxx -t "OpenXX Running" --priority low -c "Bot active | $(date +%H:%M)" --ongoing 2>/dev/null; sleep 300; done' > /dev/null 2>&1 &
        echo -e "${GREEN}✓ Keep-alive started${NC}"
        echo -e "Notification akan refresh tiap 5 menit"
        echo -e "Pastikan: Settings > Apps > Termux > Battery > Unrestricted"
        ;;
    tailscale|ts)
        bash "$INSTALL_DIR/scripts/tailscale-setup.sh"
        ;;
    notify)
        termux-notification -i openxx -t "OpenXX Running" --priority low -c "Bot is active" --ongoing 2>/dev/null
        echo -e "${GREEN}✓ Notification sent${NC}"
        ;;
    *)
        # Show interactive menu if no args
        if [ -z "$1" ]; then
            while true; do
                show_menu
            done
        else
            echo "Usage: openxx [start|stop|restart|status|logs|logs-mcp|update|keepalive|notify]"
        fi
        ;;
esac
