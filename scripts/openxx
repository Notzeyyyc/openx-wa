#!/bin/bash
# OpenXX CLI

GREEN='\033[0;32m'
RED='\033[0;31m'
CYAN='\033[0;36m'
NC='\033[0m'

case "$1" in
    status)
        echo -e "${CYAN}=== OpenXX Status ===${NC}"
        pm2 status
        ;;
    logs)
        pm2 logs openxx-bot --lines 50
        ;;
    restart)
        echo -e "${CYAN}Restarting bot...${NC}"
        pm2 restart openxx-bot
        echo -e "${GREEN}✓ Bot restarted${NC}"
        ;;
    stop)
        echo -e "${RED}Stopping bot...${NC}"
        pm2 stop openxx-bot
        echo -e "${GREEN}✓ Bot stopped${NC}"
        ;;
    update)
        echo -e "${CYAN}Updating...${NC}"
        cd ~/openxx 2>/dev/null || cd .
        git pull
        pnpm install
        pm2 restart openxx-bot
        echo -e "${GREEN}✓ Updated and restarted${NC}"
        ;;
    *)
        echo -e "${CYAN}OpenXX Commands:${NC}"
        echo "  openxx status   — check status"
        echo "  openxx logs     — view logs"
        echo "  openxx restart  — restart bot"
        echo "  openxx stop     — stop bot"
        echo "  openxx update   — update and restart"
        ;;
esac
